# Website Roaster — environment variables
#
# Copy to `.env.local` for local development. Never commit a filled-in copy.
# Every variable listed here is parsed and validated in lib/config/env.ts.
#
# Secrets are server-side only. Do not prefix any secret with NEXT_PUBLIC_ —
# that prefix inlines the value into the client bundle (ADR-018).

# One of: development | test | production
# Next.js sets this for you; override only if you know why.
NODE_ENV=development

# One of: debug | info | warn | error | silent
# Defaults to "info", or "silent" when NODE_ENV=test.
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# AI provider (optional)
# ---------------------------------------------------------------------------
#
# AI is an enhancement layer. With none of this set, the application still
# produces the full deterministic report — findings, scores and ranked
# recommendations — and says why the AI section is absent (ADR-016).
#
# Unlike every other variable in this file, a bad value here does NOT stop the
# application starting. It disables AI, records the reason, and everything else
# carries on. See lib/ai/config.ts.

# Which adapter to use. Supported: gemini
AI_PROVIDER=gemini

# Server-side only. Never prefix with NEXT_PUBLIC_ (ADR-018).
# Gemini keys: https://aistudio.google.com/apikey
AI_API_KEY=

# Optional. Defaults to the adapter's model, currently gemini-2.0-flash.
# Must be multimodal: screenshots are part of the AI input (ADR-014, ADR-034).
AI_MODEL=

# Optional. Milliseconds, 1000-120000. Defaults to 30000.
AI_TIMEOUT_MS=

# Where analysis job records are stored (ADR-031).
# Defaults to .data/jobs under the working directory. Point this at a mounted
# volume in a deployment so records survive a new build.
ANALYSIS_STORE_DIR=
